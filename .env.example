# MEDExplain AI Environment Configuration
# Copy this file to .env and fill in your API credentials.

# Google Gemini AI API Key (Required for medical report explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Session Security Key
FLASK_SECRET_KEY=your_random_flask_secret_key_here

# Google OAuth 2.0 Credentials (Optional: required for "Continue with Google" sign in)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
